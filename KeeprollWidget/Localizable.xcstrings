{
  "sourceLanguage": "en",
  "strings": {
    "%@ free": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ खाली"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ காலி"
          }
        }
      }
    },
    "%lld%%": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%%"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%%"
          }
        }
      }
    },
    "Free space on this iPhone, and how much Keeproll can clean.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone की खाली जगह, और Keeproll कितना साफ़ कर सकता है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த iPhone இன் காலி இடம், மற்றும் Keeproll எவ்வளவு சுத்தம் செய்யலாம்."
          }
        }
      }
    },
    "Keeproll": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll"
          }
        }
      }
    },
    "Open Keeproll to scan": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन के लिए Keeproll खोलें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன் செய்ய Keeproll ஐத் திறக்கவும்"
          }
        }
      }
    },
    "Storage": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टोरेज"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமிப்பகம்"
          }
        }
      }
    },
    "Up to %@ to clean": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिकतम %@ साफ़ करने को"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அதிகபட்சம் %@ சுத்தம் செய்ய"
          }
        }
      }
    },
    "free": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाली"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காலி"
          }
        }
      }
    },
    "of %@": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में से"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இல்"
          }
        }
      }
    }
  },
  "version": "1.0"
}