    "Some signs, but it could be an export from an editing app. Check before you select.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ संकेत हैं, पर यह किसी एडिटिंग ऐप से निर्यात भी हो सकता है। चुनने से पहले जाँचें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சில அறிகுறிகள் உள்ளன, ஆனால் இது ஒரு எடிட்டிங் ஆப்பின் ஏற்றுமதியாகவும் இருக்கலாம். தேர்வு செய்யும் முன் சரிபார்க்கவும்."
          }
        }
      }
    },
    "Something went wrong reading your photo library. Please try again.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ोटो लाइब्रेरी पढ़ने में कुछ गड़बड़ हुई। कृपया फिर कोशिश करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் புகைப்பட லைப்ரரியைப் படிப்பதில் தவறு. மீண்டும் முயற்சிக்கவும்."
          }
        }
      }
    },
    "Start using Keeproll": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll इस्तेमाल करना शुरू करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll ஐப் பயன்படுத்தத் தொடங்கு"
          }
        }
      }
    },
    "Step %lld of %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Step %1$lld of %2$lld"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चरण %lld में से %lld"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படி %lld / %lld"
          }
        }
      }
    },
    "Still scanning — groups appear as they're found": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन जारी है — समूह मिलते ही दिखेंगे"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் ஸ்கேன் ஆகிறது — கிடைத்ததும் குழுக்கள் தோன்றும்"
          }
        }
      }
    },
    "Storage forecast": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टोरेज पूर्वानुमान"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமிப்பக முன்னறிவிப்பு"
          }
        }
      }
    },
    "Swipe to sort": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वाइप करके छाँटें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்வைப் செய்து வகைப்படுத்து"
          }
        }
      }
    },
    "Tap Add to move private photos and videos here.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निजी फ़ोटो और वीडियो यहाँ लाने के लिए 'जोड़ें' टैप करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தனிப்பட்ட புகைப்படங்களையும் வீடியோக்களையும் இங்கே கொண்டுவர 'சேர்' தட்டவும்."
          }
        }
      }
    },
    "Tap Cancel to stop. Nothing is saved until it finishes.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोकने के लिए रद्द करें पर टैप करें। पूरा होने तक कुछ भी सेव नहीं होता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிறுத்த ரத்துசெய் என்பதைத் தட்டவும். முடியும் வரை எதுவும் சேமிக்கப்படாது."
          }
        }
      }
    },
    "Tap Scan to see what can be freed": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या खाली हो सकता है देखने के लिए स्कैन टैप करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என்ன காலியாக்கலாம் என்று பார்க்க ஸ்கேன் தட்டவும்"
          }
        }
      }
    },
    "Tap a thumbnail to watch before you decide.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तय करने से पहले देखने के लिए थंबनेल टैप करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிவு செய்யும் முன் பார்க்க சிறுபடத்தைத் தட்டவும்."
          }
        }
      }
    },
    "Tap an item to keep it.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रखने के लिए आइटम पर टैप करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வைத்திருக்க ஒன்றைத் தட்டவும்."
          }
        }
      }
    },
    "Tap to allow access": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सेस देने के लिए टैप करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அணுகல் தர தட்டவும்"
          }
        }
      }
    },
    "Text is read on this iPhone and never stored. Only the kind and the date are kept.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट इसी iPhone पर पढ़ा जाता है और कभी सेव नहीं होता। सिर्फ़ किस्म और तारीख़ रखी जाती है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உரை இந்த iPhone இலேயே படிக்கப்படும், ஒருபோதும் சேமிக்கப்படாது. வகையும் தேதியும் மட்டுமே வைக்கப்படும்."
          }
        }
      }
    },
    "The original is in Review. Remove it there to free %@.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असली फ़ाइल समीक्षा में है। %@ खाली करने के लिए उसे वहाँ हटाएँ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அசல் சரிபார்ப்பில் உள்ளது. %@ காலியாக்க அங்கே நீக்கவும்."
          }
        }
      }
    },
    "The originals are in Review. Remove them there to free %@.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असली फ़ाइलें समीक्षा में हैं। %@ खाली करने के लिए उन्हें वहाँ हटाएँ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அசல்கள் சரிபார்ப்பில் உள்ளன. %@ காலியாக்க அங்கே நீக்கவும்."
          }
        }
      }
    },
    "The same person saved more than once": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही व्यक्ति एक से ज़्यादा बार सेव"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரே நபர் ஒன்றுக்கு மேற்பட்ட முறை சேமிக்கப்பட்டவர்"
          }
        }
      }
    },
    "The same person saved twice": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही व्यक्ति दो बार सेव"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரே நபர் இருமுறை சேமிக்கப்பட்டவர்"
          }
        }
      }
    },
    "The sharpest shot in each group is marked Best. Tap a photo to compare; hold to make it Best.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर समूह की सबसे साफ़ फ़ोटो 'सबसे अच्छी' है। तुलना के लिए टैप करें; सबसे अच्छी बनाने के लिए दबाए रखें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு குழுவிலும் தெளிவான ஷாட் 'சிறந்தது' எனக் குறிக்கப்படும். ஒப்பிட தட்டவும்; சிறந்ததாக்க அழுத்திப் பிடிக்கவும்."
          }
        }
      }
    },
    "The smaller copy couldn't be saved to your library. Nothing was changed.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटी कॉपी आपकी लाइब्रेरी में सेव नहीं हो सकी। कुछ नहीं बदला।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சிறிய நகலை உங்கள் லைப்ரரியில் சேமிக்க முடியவில்லை. எதுவும் மாறவில்லை."
          }
        }
      }
    },
    "The still couldn't be exported. Nothing was changed.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थिर फ़ोटो निर्यात नहीं हो सकी। कुछ नहीं बदला।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிலைப் படத்தை ஏற்றுமதி செய்ய முடியவில்லை. எதுவும் மாறவில்லை."
          }
        }
      }
    },
    "The still couldn't be saved to your library. Nothing was changed.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थिर फ़ोटो आपकी लाइब्रेरी में सेव नहीं हो सकी। कुछ नहीं बदला।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிலைப் படத்தை உங்கள் லைப்ரரியில் சேமிக்க முடியவில்லை. எதுவும் மாறவில்லை."
          }
        }
      }
    },
    "The still image couldn't be read. Nothing was changed.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थिर फ़ोटो पढ़ी नहीं जा सकी। कुछ नहीं बदला।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிலைப் படத்தைப் படிக்க முடியவில்லை. எதுவும் மாறவில்லை."
          }
        }
      }
    },
    "The trimmed copy wouldn't be much smaller, because the dark parts take almost no space. Nothing was changed.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काटी गई कॉपी ज़्यादा छोटी नहीं होती, क्योंकि अंधेरे हिस्से लगभग कोई जगह नहीं लेते। कुछ नहीं बदला।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெட்டிய நகல் அதிகம் சிறியதாக இருக்காது, ஏனெனில் இருண்ட பகுதிகள் கிட்டத்தட்ட இடம் எடுக்கவில்லை. எதுவும் மாற்றப்படவில்லை."
          }
        }
      }
    },
    "The trimmed copy wouldn't be smaller, because the dark parts take almost no space. Nothing was changed.": {
      "extractionState": "stale",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काटी गई कॉपी छोटी नहीं होती, क्योंकि अंधेरे हिस्से लगभग कोई जगह नहीं लेते। कुछ नहीं बदला।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெட்டிய நகல் சிறியதாக இருக்காது, ஏனெனில் இருண்ட பகுதிகள் கிட்டத்தட்ட இடம் எடுக்கவில்லை. எதுவும் மாற்றப்படவில்லை."
          }
        }
      }
    },
    "The vault is protected by your iPhone passcode and is included in your iPhone backups. Deleting Keeproll deletes the vault, so save anything you want to keep to Photos first.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्ट आपके iPhone पासकोड से सुरक्षित है और आपके iPhone बैकअप में शामिल है। Keeproll हटाने से वॉल्ट भी हट जाता है, इसलिए जो रखना है उसे पहले फ़ोटो में सेव करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வால்ட் உங்கள் iPhone கடவுக்குறியீட்டால் பாதுகாக்கப்படுகிறது, உங்கள் iPhone காப்புப்பிரதிகளிலும் சேர்க்கப்படுகிறது. Keeproll-ஐ நீக்கினால் வால்ட்டும் நீங்கும், எனவே வைத்திருக்க வேண்டியதை முதலில் Photos-இல் சேமிக்கவும்."
          }
        }
      }
    },
    "The video couldn't be compressed. Nothing was changed.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीडियो कंप्रेस नहीं हो सका। कुछ नहीं बदला।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வீடியோவைச் சுருக்க முடியவில்லை. எதுவும் மாறவில்லை."
          }
        }
      }
    },
    "These photos are no longer in the list.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये फ़ोटो अब सूची में नहीं हैं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் புகைப்படங்கள் இப்போது பட்டியலில் இல்லை."
          }
        }
      }
    },
    "This Live Photo is no longer in your library.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Live Photo अब आपकी लाइब्रेरी में नहीं है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Live Photo இப்போது உங்கள் லைப்ரரியில் இல்லை."
          }
        }
      }
    },
    "This calendar doesn't allow changes.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कैलेंडर बदलाव की अनुमति नहीं देता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் காலண்டர் மாற்றங்களை அனுமதிக்காது."
          }
        }
      }
    },
    "This contact is in more than one change. Open Duplicate Contacts and choose again.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह संपर्क एक से ज़्यादा बदलावों में है। डुप्लिकेट संपर्क खोलें और फिर से चुनें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தத் தொடர்பு ஒன்றுக்கு மேற்பட்ட மாற்றங்களில் உள்ளது. நகல் தொடர்புகளைத் திறந்து மீண்டும் தேர்வுசெய்யவும்."
          }
        }
      }
    },
    "This contact no longer exists.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह संपर्क अब मौजूद नहीं है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தத் தொடர்பு இப்போது இல்லை."
          }
        }
      }
    },
    "This contact's account doesn't allow changes.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस संपर्क का अकाउंट बदलाव की अनुमति नहीं देता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தத் தொடர்பின் கணக்கு மாற்றங்களை அனுமதிக்காது."
          }
        }
      }
    },
    "This event no longer exists or can't be changed.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इवेंट अब मौजूद नहीं है या बदला नहीं जा सकता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நிகழ்வு இப்போது இல்லை அல்லது மாற்ற முடியாது."
          }
        }
      }
    },
    "This is the only copy Keeproll keeps. Save it to Photos first if you want to keep it.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Keeproll की इकलौती कॉपी है। रखना चाहते हैं तो पहले फ़ोटो में सेव करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது Keeproll வைத்திருக்கும் ஒரே நகல். வைத்திருக்க விரும்பினால் முதலில் Photos இல் சேமிக்கவும்."
          }
        }
      }
    },
    "This item is still in your library.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आइटम अभी भी आपकी लाइब्रेरी में है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இன்னும் உங்கள் லைப்ரரியில் உள்ளது."
          }
        }
      }
    },
    "This video has extra tracks (Cinematic, slow motion or spatial) that a trimmed copy can't keep. Nothing was changed.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वीडियो में अतिरिक्त ट्रैक हैं (Cinematic, स्लो मोशन या स्पेशियल) जिन्हें काटी गई कॉपी नहीं रख सकती। कुछ नहीं बदला।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வீடியோவில் வெட்டிய நகல் வைத்திருக்க முடியாத கூடுதல் டிராக்குகள் உள்ளன (Cinematic, ஸ்லோ மோஷன் அல்லது ஸ்பேஷியல்). எதுவும் மாற்றப்படவில்லை."
          }
        }
      }
    },
    "This video is already compact. A smaller copy wouldn't save much, so nothing was changed.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वीडियो पहले से छोटा है। छोटी कॉपी से ज़्यादा बचत नहीं होती, इसलिए कुछ नहीं बदला।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வீடியோ ஏற்கனவே சிறியது. சிறிய நகலால் பெரிதாகச் சேமிக்க முடியாது, எனவே எதுவும் மாறவில்லை."
          }
        }
      }
    },
    "This video is no longer in your library.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वीडियो अब आपकी लाइब्रेरी में नहीं है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வீடியோ இப்போது உங்கள் லைப்ரரியில் இல்லை."
          }
        }
      }
