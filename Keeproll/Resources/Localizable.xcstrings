    "One flat colour with no detail, like a ceiling or the inside of a case.": {
      "extractionState": "stale",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना डिटेल का एक ही रंग, जैसे छत या कवर का अंदरूनी हिस्सा।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விவரம் இல்லாத ஒரே நிறம், கூரை அல்லது கவரின் உட்பகுதி போல."
          }
        }
      }
    },
    "One flat grey with no detail, like a ceiling or the inside of a case.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना डिटेल का एक ही स्लेटी रंग, जैसे छत या कवर का अंदरूनी हिस्सा।"
          }
