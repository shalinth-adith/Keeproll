        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நகல் நிகழ்வுகள் இல்லை, ஓராண்டுக்கும் பழையது எதுவுமில்லை."
          }
        }
      }
    },
    "No duplicates": {
      "localizations": {
