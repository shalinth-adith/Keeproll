      }
    },
    "Deleted photos stay in Recently Deleted for 30 days. Empty it in the Photos app to get the space back now.": {
      "extractionState": "stale",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाई गई फ़ोटो 30 दिन 'हाल ही में हटाए गए' में रहती हैं। जगह अभी पाने के लिए फ़ोटो ऐप में उसे खाली करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீக்கிய புகைப்படங்கள் 30 நாட்கள் 'சமீபத்தில் நீக்கியவை' இல் இருக்கும். இடத்தை இப்போதே பெற Photos ஆப்பில் அதைக் காலி செய்யவும்."
          }
        }
      }
    },
    "Deleted photos stay in Recently Deleted for 30 days. To get the space back now, open Photos, go to Recently Deleted under Utilities, and delete them there.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाई गई फ़ोटो 30 दिन तक हाल ही में हटाए गए में रहती हैं। अभी जगह वापस पाने के लिए फ़ोटो ऐप खोलें, यूटिलिटी के नीचे हाल ही में हटाए गए में जाएँ, और उन्हें वहाँ हटाएँ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீக்கப்பட்ட படங்கள் 30 நாட்கள் சமீபத்தில் நீக்கியவை பகுதியில் இருக்கும். இப்போதே இடத்தைத் திரும்பப் பெற, Photos-ஐத் திறந்து, Utilities கீழ் சமீபத்தில் நீக்கியவை சென்று, அங்கே அவற்றை நீக்கவும்."
          }
        }
      }
    },
    "Delivered weeks ago · taken %@": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हफ़्तों पहले डिलीवर · %@ को लिया"
