        }
      }
    },
    "Cut dark parts of videos": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीडियो के अंधेरे हिस्से काटें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வீடியோக்களின் இருண்ட பகுதிகளை வெட்டவும்"
          }
        }
      }
    },
    "Cuts %@ of %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Cuts %1$@ of %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ कटेगा, कुल %@ में से"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ வெட்டப்படும், மொத்தம் %@"
          }
        }
      }
    },
    "Cuts %@ · saves about %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Cuts %1$@ · saves about %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ कटेगा · लगभग %@ बचेगा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ வெட்டப்படும் · சுமார் %@ சேமிக்கும்"
          }
        }
      }
    },
    "Cuts the dark, empty stretches out of videos and keeps the rest at full quality.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीडियो के अंधेरे, खाली हिस्से काटता है और बाकी पूरी क्वालिटी में रखता है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வீடியோக்களின் இருண்ட, வெற்றுப் பகுதிகளை வெட்டி, மீதியை முழுத் தரத்தில் வைக்கிறது."
          }
        }
      }
    },
    "Dark and silent": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंधेरा और शांत"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இருட்டும் அமைதியும்"
          }
        }
      }
    },
    "Data on this iPhone": {
