    "Similar shots, screenshots, blurry photos and large videos": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिलते-जुलते शॉट, स्क्रीनशॉट, धुंधली फ़ोटो और बड़े वीडियो"
