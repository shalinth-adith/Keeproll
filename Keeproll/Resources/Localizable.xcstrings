    },
    "Set a passcode in Settings to use the vault. Without one, nothing can protect it.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्ट इस्तेमाल करने के लिए सेटिंग्स में पासकोड सेट करें। इसके बिना इसकी सुरक्षा नहीं हो सकती।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பெட்டகத்தைப் பயன்படுத்த அமைப்புகளில் கடவுக்குறியீடு அமைக்கவும். அது இல்லாமல் பாதுகாக்க முடியாது."
          }
        }
      }
    },
    "Set up access": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सेस सेट करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அணுகலை அமை"
          }
