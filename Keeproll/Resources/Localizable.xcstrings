    "Extra shots from similar groups and blurry photos. Nothing is removed until you confirm on Review.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिलते-जुलते समूहों की अतिरिक्त फ़ोटो और धुंधली फ़ोटो। समीक्षा में पुष्टि तक कुछ नहीं हटता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒத்த குழுக்களின் கூடுதல் ஷாட்களும் மங்கலான புகைப்படங்களும். சரிபார்ப்பில் உறுதிசெய்யும் வரை எதுவும் நீக்கப்படாது."
          }
        }
      }
    },
    "Favourites are never suggested. Drag sideways to select several at once.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पसंदीदा कभी नहीं सुझाई जातीं। कई चुनने के लिए आड़ा खींचें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிடித்தவை ஒருபோதும் பரிந்துரைக்கப்படாது. பலவற்றைத் தேர்வு செய்ய பக்கவாட்டில் இழுக்கவும்."
          }
        }
      }
    },
    "Favourites are never suggested. Nothing is selected until you choose.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पसंदीदा कभी सुझाए नहीं जाते। आपके चुनने तक कुछ भी चुना नहीं जाता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிடித்தவை ஒருபோதும் பரிந்துரைக்கப்படாது. நீங்கள் தேர்வுசெய்யும் வரை எதுவும் தேர்ந்தெடுக்கப்படாது."
          }
        }
      }
    },
    "Filling at %@ a week. “Full” means under %@ free, where iOS starts to struggle.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Filling at %1$@ a week. “Full” means under %2$@ free, where iOS starts to struggle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर हफ़्ते %@ भर रहा है। “भरा” का मतलब %@ से कम खाली, जहाँ iOS अटकने लगता है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வாரத்திற்கு %@ நிரம்புகிறது. “நிரம்பியது” என்றால் %@ க்கும் குறைவான காலி இடம், அங்கே iOS சிரமப்படத் தொடங்கும்."
          }
        }
      }
    },
