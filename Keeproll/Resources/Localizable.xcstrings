    },
    "Contact and calendar backups are now listed in Settings, to share or delete.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपर्क और कैलेंडर बैकअप अब सेटिंग्स में दिखते हैं, शेयर करने या हटाने के लिए।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடர்பு மற்றும் நாள்காட்டி காப்புப்பிரதிகள் இப்போது அமைப்புகளில் உள்ளன, பகிர அல்லது நீக்க."
          }
        }
      }
    },
    "Contact changes aren't available.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपर्क बदलाव उपलब्ध नहीं हैं।"
