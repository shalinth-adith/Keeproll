    },
    "^[%lld photo](inflect: true) queued · %@. Nothing is removed until you confirm on Review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "^[%1$lld photo](inflect: true) queued · %2$@. Nothing is removed until you confirm on Review."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld फ़ोटो कतार में · %@। समीक्षा में पुष्टि तक कुछ नहीं हटता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld புகைப்படங்கள் வரிசையில் · %@. சரிபார்ப்பில் உறுதிசெய்யும் வரை எதுவும் நீக்கப்படாது."
          }
        }
      }
    },
    "^[%lld photo](inflect: true) you probably didn't mean to take": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld फ़ोटो जो शायद गलती से ली गईं"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தவறுதலாக எடுத்திருக்கக்கூடிய %lld படங்கள்"
          }
        }
      }
    },
    "^[%lld photo](inflect: true) · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "^[%1$lld photo](inflect: true) · %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld फ़ोटो · %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld புகைப்படங்கள் · %@"
          }
        }
      }
    },
    "^[%lld photo](inflect: true) · %@ to free": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "^[%1$lld photo](inflect: true) · %2$@ to free"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld फ़ोटो · %@ खाली होगा"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
