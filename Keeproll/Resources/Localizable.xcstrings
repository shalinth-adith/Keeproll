          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld மாற்றங்கள்"
          }
        }
      }
    },
    "^[%lld contact change](inflect: true)": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld संपर्क बदलाव"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld தொடர்பு மாற்றங்கள்"
          }
        }
      }
    },
    "^[%lld contact](inflect: true)": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld संपर्क"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld தொடர்புகள்"
          }
        }
      }
    },
    "^[%lld contact](inflect: true) that look like the same people": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld संपर्क जो एक ही लोग लगते हैं"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரே நபர்கள் போலத் தெரியும் %lld தொடர்புகள்"
          }
        }
      }
    },
    "^[%lld duplicate](inflect: true)": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
