        }
      }
    },
    "Scan first, then swipe through the suggestions.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले स्कैन करें, फिर सुझावों पर स्वाइप करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலில் ஸ்கேன் செய்து, பின்னர் பரிந்துரைகளை ஸ்வைப் செய்யுங்கள்."
          }
        }
      }
    },
    "Scan my iPhone": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरा iPhone स्कैन करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என் iPhone ஐ ஸ்கேன் செய்"
          }
        }
      }
    },
    "Scan: Keeproll finds similar photos, screenshots, blurry shots, large videos, duplicate contacts and old events.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन: Keeproll मिलती-जुलती फ़ोटो, स्क्रीनशॉट, धुंधले शॉट, बड़े वीडियो, डुप्लिकेट संपर्क और पुराने इवेंट खोजता है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன்: Keeproll ஒத்த புகைப்படங்கள், ஸ்கிரீன்ஷாட்கள், மங்கலான ஷாட்கள், பெரிய வீடியோக்கள், நகல் தொடர்புகள், பழைய நிகழ்வுகளைக் கண்டறியும்."
          }
        }
      }
    },
    "Scanning": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन हो रहा है"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன் ஆகிறது"
          }
        }
      }
    },
    "Scanning…": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन हो रहा है…"
