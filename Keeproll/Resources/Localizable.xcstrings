          }
        }
      }
    },
    "Converting": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदल रहे हैं"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாற்றுகிறது"
          }
        }
      }
    },
    "Copies of these are safe in your vault. This removes the originals from your library.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनकी कॉपी आपके वॉल्ट में सुरक्षित हैं। यह असली फ़ाइलें आपकी लाइब्रेरी से हटाता है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இவற்றின் நகல்கள் உங்கள் பெட்டகத்தில் பாதுகாப்பாக உள்ளன. இது அசல்களை உங்கள் லைப்ரரியிலிருந்து நீக்கும்."
          }
        }
      }
    },
    "Copying %lld of %lld…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Copying %1$lld of %2$lld…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld में से %lld कॉपी हो रहे हैं…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld நகலெடுக்கிறது…"
          }
        }
      }
    },
    "Couldn't back up this event, so it wasn't removed.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस इवेंट का बैकअप नहीं हो सका, इसलिए इसे हटाया नहीं गया।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நிகழ்வை காப்புப்பிரதி எடுக்க முடியவில்லை, அதனால் அது நீக்கப்படவில்லை."
          }
        }
      }
    },
    "Couldn't read this iPhone's storage.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस iPhone का स्टोरेज पढ़ा नहीं जा सका।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த iPhone இன் சேமிப்பகத்தைப் படிக்க முடியவில்லை."
          }
        }
      }
    },
    "Couldn't remove this item. Try again.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आइटम हटाया नहीं जा सका। फिर से कोशिश करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதை நீக்க முடியவில்லை. மீண்டும் முயலவும்."
          }
        }
      }
    },
    "Couldn't save a backup first, so nothing was changed.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले बैकअप नहीं बन सका, इसलिए कुछ नहीं बदला।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலில் காப்புப் பிரதி சேமிக்க முடியவில்லை, எனவே எதுவும் மாறவில்லை."
          }
        }
      }
    },
    "Couldn't save to your library.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी में सेव नहीं हो सका।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் லைப்ரரியில் சேமிக்க முடியவில்லை."
          }
        }
      }
    },
    "Coupons and offers": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कूपन और ऑफ़र"
