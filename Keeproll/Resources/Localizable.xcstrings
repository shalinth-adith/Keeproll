            "value": "'बहुत संभावित' हटाएँ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "'மிகச் சாத்தியம்' தேர்வை நீக்கு"
          }
        }
      }
    },
    "Cleared. The next scan will take longer.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटा दिया। अगला स्कैन ज़्यादा समय लेगा।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீக்கப்பட்டது. அடுத்த ஸ்கேன் அதிக நேரம் எடுக்கும்."
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद करें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மூடு"
          }
        }
      }
    },
    "Codes stop working within minutes · taken %@": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड मिनटों में बेकार हो जाते हैं · %@ को लिया"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறியீடுகள் நிமிடங்களில் செயலிழக்கும் · %@ அன்று எடுத்தது"
          }
        }
      }
    },
    "Codes, passes and tickets that are past their date, read on your iPhone.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड, पास और टिकट जिनकी तारीख़ निकल गई, आपके iPhone पर पढ़े गए।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேதி கடந்த குறியீடுகள், பாஸ்கள், டிக்கெட்டுகள், உங்கள் iPhone இல் படிக்கப்பட்டவை."
          }
        }
      }
    },
    "Compare": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुलना करें"
          }
        },
