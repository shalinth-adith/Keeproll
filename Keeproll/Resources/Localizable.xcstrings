          "stringUnit": {
            "state": "translated",
            "value": "தொடர்பை நீக்கு"
          }
        }
      }
    },
    "Delete this backup?": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बैकअप हटाएँ?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் காப்புப்பிரதியை நீக்கவா?"
          }
        }
      }
    },
    "Delete this contact": {
