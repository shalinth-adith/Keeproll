    },
    "^[%lld still](inflect: true) saved": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld स्थिर फ़ोटो सेव हुईं"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld நிலைப் படங்கள் சேமிக்கப்பட்டன"
          }
        }
      }
    },
    "^[%lld video](inflect: true) with dark or empty stretches": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld वीडियो जिनमें अंधेरे या खाली हिस्से हैं"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இருண்ட அல்லது வெற்றுப் பகுதிகள் உள்ள %lld வீடியோக்கள்"
          }
        }
      }
    },
    "^[%lld video](inflect: true) · largest first": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld वीडियो · सबसे बड़ा पहले"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld வீடியோக்கள் · பெரியது முதலில்"
          }
        }
      }
    },
    "can be freed": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाली हो सकता है"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காலியாக்கலாம்"
          }
        }
      }
    },
    "chat-app file name": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट ऐप जैसा फ़ाइल नाम"
          }
        },
        "ta": {
          "stringUnit": {
