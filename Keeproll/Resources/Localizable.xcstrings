      }
    },
    "No duplicate events, and nothing older than a year.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई डुप्लिकेट इवेंट नहीं, और कुछ भी एक साल से पुराना नहीं।"
          }
