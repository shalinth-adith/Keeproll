        }
      }
    },
    "cleaned up": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साफ़ किया"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுத்தம் செய்யப்பட்டது"
          }
        }
      }
    },
    "duplicates and events over a year old": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डुप्लिकेट और एक साल से पुराने इवेंट"
