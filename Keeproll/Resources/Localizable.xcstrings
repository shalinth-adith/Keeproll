    "Nothing in your library changes. The next scan recomputes photo features, so it takes as long as the first one did.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी में कुछ नहीं बदलता। अगला स्कैन फ़ोटो की जानकारी फिर से निकालेगा, इसलिए पहले जितना समय लेगा।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் லைப்ரரியில் எதுவும் மாறாது. அடுத்த ஸ்கேன் புகைப்படத் தகவலை மீண்டும் கணக்கிடும், எனவே முதல் முறை எடுத்த நேரம் எடுக்கும்."
          }
        }
      }
    },
