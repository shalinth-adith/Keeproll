    },
    "^[%lld Live Photo](inflect: true) couldn't be converted and ^[%lld was](inflect: true) left unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "^[%1$lld Live Photo](inflect: true) couldn't be converted and ^[%2$lld was](inflect: true) left unchanged."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Live Photos बदली नहीं जा सकीं और %lld वैसी ही रहीं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Live Photos ஐ மாற்ற முடியவில்லை; %lld மாறாமல் உள்ளன."
          }
