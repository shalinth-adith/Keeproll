    "Private: everything stays on your iPhone. No account, no upload.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निजी: सब कुछ आपके iPhone पर रहता है। न अकाउंट, न अपलोड।"
