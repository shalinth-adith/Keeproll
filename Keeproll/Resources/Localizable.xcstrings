            "state": "translated",
            "value": "%@। अधिकतम %@ खाली हो सकता है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. அதிகபட்சம் %@ காலியாக்கலாம்."
          }
        }
      }
    },
