    "Open Keeproll on ^[%lld more day](inflect: true) to see where your storage is heading.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टोरेज का रुझान देखने के लिए Keeproll को %lld और दिन खोलें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சேமிப்பகம் எங்கே செல்கிறது என்று பார்க்க Keeproll ஐ இன்னும் %lld நாட்கள் திறக்கவும்."
          }
        }
      }
    },
    "Open Photos": {
