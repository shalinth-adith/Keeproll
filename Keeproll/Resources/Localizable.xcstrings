          }
        }
      }
    },
    "One photo at a time. Right to keep, left to remove.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार में एक फ़ोटो। रखने के लिए दाएँ, हटाने के लिए बाएँ।"
