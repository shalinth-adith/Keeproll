            "state": "translated",
            "value": "%lld புகைப்படங்கள்"
          }
        }
      }
    },
    "^[%lld photo](inflect: true) out of focus": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld फ़ोटो फ़ोकस से बाहर"
