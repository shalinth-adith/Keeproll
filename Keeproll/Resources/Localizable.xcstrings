            "value": "பெயர் இல்லை"
          }
        }
      }
    },
    "No pocket shots, black frames or finger-over-lens photos.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जेब में ली गई, काली या लेंस पर उंगली वाली कोई फ़ोटो नहीं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பையில் எடுத்த, கருப்பு அல்லது லென்ஸ் மேல் விரல் உள்ள படங்கள் இல்லை."
          }
        }
      }
    },
    "No reports": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई रिपोर्ट नहीं"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிக்கைகள் இல்லை"
          }
        }
      }
    },
    "No screenshots are older than 30 days.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई स्क्रीनशॉट 30 दिन से पुराना नहीं है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "30 நாட்களுக்குப் பழைய ஸ்கிரீன்ஷாட்கள் இல்லை."
          }
        }
      }
    },
    "No screenshots of codes, passes or tickets that are past their date.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड, पास या टिकट का कोई स्क्रीनशॉट नहीं जिसकी तारीख़ निकल गई हो।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேதி கடந்த குறியீடு, பாஸ் அல்லது டிக்கெட் ஸ்கிரீன்ஷாட்கள் இல்லை."
          }
        }
      }
    },
    "No similar photos": {
      "localizations": {
