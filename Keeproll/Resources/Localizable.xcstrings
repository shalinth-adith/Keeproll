    "%lld copied, but the original stays in your library because it has RAW data or edits the vault can't keep.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld कॉपी हुईं, लेकिन असली फ़ोटो आपकी लाइब्रेरी में रहेगी, क्योंकि उसमें RAW डेटा या एडिट हैं जिन्हें वॉल्ट नहीं रख सकता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld நகலெடுக்கப்பட்டன, ஆனால் அசல் உங்கள் லைப்ரரியில் இருக்கும், ஏனெனில் அதில் வால்ட் வைத்திருக்க முடியாத RAW தரவு அல்லது திருத்தங்கள் உள்ளன."
          }
        }
      }
    },
    "%lld couldn't be copied and stay in your library.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld कॉपी नहीं हो सके और आपकी लाइब्रेरी में ही हैं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ஐ நகலெடுக்க முடியவில்லை; அவை உங்கள் லைப்ரரியில் உள்ளன."
          }
        }
      }
    },
    "%lld from other apps": {
      "localizations": {
