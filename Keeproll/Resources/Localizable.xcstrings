          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld நகல்கள்"
          }
        }
      }
    },
    "^[%lld event](inflect: true)": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld इवेंट"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld நிகழ்வுகள்"
          }
        }
      }
    },
    "^[%lld group](inflect: true)": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld समूह"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld குழுக்கள்"
          }
        }
      }
    },
    "^[%lld group](inflect: true) · ^[%lld photo](inflect: true)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "^[%1$lld group](inflect: true) · ^[%2$lld photo](inflect: true)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld समूह · %lld फ़ोटो"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld குழுக்கள் · %lld புகைப்படங்கள்"
          }
        }
      }
    },
    "^[%lld item](inflect: true)": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld आइटम"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld உருப்படிகள்"
          }
        }
      }
    },
    "^[%lld item](inflect: true) (%@) are only in iCloud. Removing them frees iCloud space, not iPhone storage.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "^[%1$lld item](inflect: true) (%2$@) are only in iCloud. Removing them frees iCloud space, not iPhone storage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld आइटम (%@) सिर्फ़ iCloud में हैं। इन्हें हटाने से iCloud की जगह खाली होती है, iPhone की नहीं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld உருப்படிகள் (%@) iCloud இல் மட்டுமே உள்ளன. இவற்றை நீக்குவது iCloud இடத்தைக் காலியாக்கும், iPhone சேமிப்பகத்தை அல்ல."
          }
        }
      }
    },
    "^[%lld item](inflect: true) copied into your vault. The originals are still in your library until you remove them on Review.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld आइटम आपके वॉल्ट में कॉपी हुए। समीक्षा में हटाने तक असली फ़ाइलें आपकी लाइब्रेरी में हैं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld உருப்படிகள் உங்கள் பெட்டகத்தில் நகலெடுக்கப்பட்டன. சரிபார்ப்பில் நீக்கும் வரை அசல்கள் உங்கள் லைப்ரரியில் இருக்கும்."
          }
        }
      }
    },
    "^[%lld item](inflect: true) couldn't be removed. They're still in your review list.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld आइटम हटाए नहीं जा सके। वे अभी भी आपकी समीक्षा सूची में हैं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld உருப்படிகளை நீக்க முடியவில்லை. அவை இன்னும் உங்கள் சரிபார்ப்புப் பட்டியலில் உள்ளன."
          }
        }
      }
    },
    "^[%lld item](inflect: true) from Photos will be removed": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो से %lld आइटम हटाए जाएँगे"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos இலிருந்து %lld உருப்படிகள் நீக்கப்படும்"
          }
        }
      }
    },
    "^[%lld item](inflect: true) reviewed and removed": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld आइटम देखे और हटाए गए"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld உருப்படிகள் சரிபார்த்து நீக்கப்பட்டன"
          }
        }
      }
    },
    "^[%lld item](inflect: true) selected": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld आइटम चुने गए"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld உருப்படிகள் தேர்வானவை"
          }
        }
      }
    },
    "^[%lld item](inflect: true) selected, %@": {
      "localizations": {
