          "stringUnit": {
            "state": "translated",
            "value": "இது இன்னும் iCloud இலிருந்து பதிவிறங்கிக் கொண்டிருக்கலாம்."
          }
        }
      }
    },
    "JPEG": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "JPEG"
          }
        }
      }
    },
    "Just now": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी-अभी"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போதுதான்"
          }
        }
      }
    },
    "KEEP": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रखें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வைத்திரு"
          }
        }
      }
    },
    "Keep": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रखें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வைத்திரு"
          }
        }
      }
    },
    "Keep Keeproll open until it finishes.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा होने तक Keeproll खुला रखें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடியும் வரை Keeproll ஐத் திறந்து வைத்திருங்கள்."
          }
        }
      }
    },
    "Keep all": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी रखें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எல்லாம் வைத்திரு"
          }
        }
      }
    },
    "Keep as is": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसा है वैसा रखें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அப்படியே வைத்திரு"
          }
        }
      }
    },
    "Keep best only": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ सबसे अच्छी रखें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சிறந்ததை மட்டும் வைத்திரு"
          }
        }
      }
    },
    "Keep one": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक रखें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒன்றை வைத்திரு"
          }
        }
      }
    },
    "Keep private photos out of your library, behind Face ID.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निजी फ़ोटो लाइब्रेरी से बाहर, Face ID के पीछे रखें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தனிப்பட்ட புகைப்படங்களை லைப்ரரிக்கு வெளியே, Face ID பின்னால் வைத்திருங்கள்."
          }
        }
      }
    },
    "Keep the still, drop the clip": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थिर फ़ोटो रखें, क्लिप हटाएँ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிலைப் படத்தை வை, கிளிப்பை நீக்கு"
          }
        }
      }
    },
    "Keep the still, drop the clip. Same date and place.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थिर फ़ोटो रखें, क्लिप हटाएँ। वही तारीख़ और जगह।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிலைப் படத்தை வை, கிளிப்பை நீக்கு. அதே தேதி, இடம்."
          }
        }
      }
    },
    "Keep this item": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे रखें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இதை வைத்திரு"
          }
        }
      }
    },
    "Keep what matters": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो मायने रखता है, वही रखें"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முக்கியமானதை வைத்திரு"
          }
        }
      }
    },
    "Keeproll": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll"
          }
        }
      }
    },
    "Keeproll %@": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll %@"
          }
        }
      }
    },
    "Keeproll can only see the photos you chose. Anything outside that selection won't be scanned.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll सिर्फ़ आपकी चुनी हुई फ़ोटो देख सकता है। उसके बाहर कुछ भी स्कैन नहीं होगा।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் தேர்ந்த புகைப்படங்களை மட்டுமே Keeproll பார்க்க முடியும். அதற்கு வெளியே எதுவும் ஸ்கேன் ஆகாது."
          }
        }
      }
    },
    "Keeproll checks contacts on this iPhone for duplicates. Nothing is uploaded.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll इस iPhone के संपर्कों में डुप्लिकेट जाँचता है। कुछ भी अपलोड नहीं होता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll இந்த iPhone இன் தொடர்புகளில் நகல்களைச் சரிபார்க்கிறது. எதுவும் பதிவேற்றப்படாது."
          }
        }
      }
    },
    "Keeproll didn't find duplicates or near-identical shots.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll को डुप्लिकेट या लगभग एक जैसी फ़ोटो नहीं मिलीं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll க்கு நகல்களோ ஏறக்குறைய ஒத்த ஷாட்களோ கிடைக்கவில்லை."
          }
        }
      }
    },
    "Keeproll doesn't have access to your contacts.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll के पास आपके संपर्कों का एक्सेस नहीं है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll க்கு உங்கள் தொடர்புகள் அணுகல் இல்லை."
          }
        }
      }
    },
    "Keeproll doesn't have access to your photos.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll के पास आपकी फ़ोटो का एक्सेस नहीं है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll க்கு உங்கள் புகைப்பட அணுகல் இல்லை."
          }
        }
      }
    },
    "Keeproll has no account, no analytics and no network access. Photos, contacts and events are read on this iPhone and never leave it. Contacts and calendar changes are backed up to a file you can share before anything is changed.": {
      "extractionState": "stale",
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll में न अकाउंट है, न एनालिटिक्स, न नेटवर्क एक्सेस। फ़ोटो, संपर्क और इवेंट इसी iPhone पर पढ़े जाते हैं और कभी बाहर नहीं जाते। संपर्क और कैलेंडर बदलने से पहले उनका बैकअप एक फ़ाइल में होता है जिसे आप शेयर कर सकते हैं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll இல் கணக்கு இல்லை, அனலிட்டிக்ஸ் இல்லை, நெட்வொர்க் அணுகல் இல்லை. புகைப்படங்கள், தொடர்புகள், நிகழ்வுகள் இந்த iPhone இலேயே படிக்கப்படும், ஒருபோதும் வெளியேறாது. தொடர்பு மற்றும் காலண்டர் மாற்றங்களுக்கு முன் நீங்கள் பகிரக்கூடிய கோப்பில் காப்புப் பிரதி எடுக்கப்படும்."
          }
        }
      }
    },
    "Keeproll has no account, no analytics and no network access. Photos, contacts and events are read on this iPhone, and Keeproll never sends them anywhere. Contacts and calendar changes are backed up to a file you can share before anything is changed.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll में कोई अकाउंट, कोई एनालिटिक्स और कोई नेटवर्क एक्सेस नहीं है। फ़ोटो, संपर्क और इवेंट इसी iPhone पर पढ़े जाते हैं, और Keeproll उन्हें कहीं नहीं भेजता। कुछ भी बदलने से पहले संपर्क और कैलेंडर के बदलावों का बैकअप एक फ़ाइल में लिया जाता है, जिसे आप शेयर कर सकते हैं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll-இல் கணக்கு இல்லை, பகுப்பாய்வு இல்லை, நெட்வொர்க் அணுகலும் இல்லை. படங்கள், தொடர்புகள், நிகழ்வுகள் இந்த iPhone-இலேயே படிக்கப்படுகின்றன, Keeproll அவற்றை எங்கும் அனுப்பாது. எதையும் மாற்றும் முன் தொடர்புகள் மற்றும் நாள்காட்டி மாற்றங்கள் நீங்கள் பகிரக்கூடிய ஒரு கோப்பில் காப்புப்பிரதி எடுக்கப்படும்."
          }
        }
      }
    },
    "Keeproll looks for duplicate events and events over a year old. Nothing is uploaded, and nothing is removed until you confirm on Review.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll डुप्लिकेट इवेंट और एक साल से पुराने इवेंट खोजता है। कुछ अपलोड नहीं होता, और समीक्षा में पुष्टि तक कुछ नहीं हटता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll நகல் நிகழ்வுகளையும் ஓராண்டுக்கும் பழைய நிகழ்வுகளையும் தேடும். எதுவும் பதிவேற்றப்படாது, சரிபார்ப்பில் உறுதிசெய்யும் வரை எதுவும் நீக்கப்படாது."
          }
        }
      }
    },
    "Keeproll needs access to your photos to find what's taking space. Nothing leaves your iPhone.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जगह क्या घेर रहा है यह जानने के लिए Keeproll को आपकी फ़ोटो का एक्सेस चाहिए। कुछ भी आपके iPhone से बाहर नहीं जाता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடத்தை எது எடுக்கிறது என்று கண்டறிய Keeproll க்கு உங்கள் புகைப்பட அணுகல் தேவை. எதுவும் உங்கள் iPhone ஐ விட்டு வெளியேறாது."
          }
        }
      }
    },
    "Keeproll needs access to your photos to move them into the vault.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो को वॉल्ट में ले जाने के लिए Keeproll को आपकी फ़ोटो का एक्सेस चाहिए।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படங்களைப் பெட்டகத்திற்கு மாற்ற Keeproll க்கு உங்கள் புகைப்பட அணுகல் தேவை."
          }
        }
      }
    },
    "Keeproll reads these on your iPhone only. Nothing is uploaded, and nothing is removed until you confirm on Review.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll इन्हें सिर्फ़ आपके iPhone पर पढ़ता है। कुछ अपलोड नहीं होता, और समीक्षा में पुष्टि तक कुछ नहीं हटता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll இவற்றை உங்கள் iPhone இல் மட்டுமே படிக்கும். எதுவும் பதிவேற்றப்படாது, சரிபார்ப்பில் உறுதிசெய்யும் வரை எதுவும் நீக்கப்படாது."
          }
        }
      }
    },
    "Keeproll saves a backup before changing any contact or event. They have no Recently Deleted, so the backup is your undo.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी संपर्क या इवेंट को बदलने से पहले Keeproll बैकअप सेव करता है। इनके लिए 'हाल ही में हटाए गए' नहीं होता, इसलिए बैकअप ही आपका पूर्ववत है।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்தத் தொடர்பையோ நிகழ்வையோ மாற்றும் முன் Keeproll காப்புப் பிரதி சேமிக்கும். அவற்றுக்கு 'சமீபத்தில் நீக்கியவை' இல்லை, எனவே காப்புப் பிரதியே உங்கள் செயல்தவிர்ப்பு."
          }
        }
      }
    },
    "Keeproll saves a copy without the %@ of dark or empty video, at the same quality, date and place. The original then goes to Review. Nothing is deleted until you confirm.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll %@ अंधेरे या खाली वीडियो के बिना एक कॉपी सेव करता है, उसी क्वालिटी, तारीख़ और जगह के साथ। फिर असली वीडियो समीक्षा में जाता है। आपकी पुष्टि तक कुछ नहीं हटता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll %@ இருண்ட அல்லது வெற்று வீடியோ இல்லாமல், அதே தரம், தேதி, இடத்துடன் ஒரு நகலைச் சேமிக்கிறது. பிறகு அசல் மதிப்பாய்வுக்குச் செல்லும். நீங்கள் உறுதிசெய்யும் வரை எதுவும் நீக்கப்படாது."
          }
        }
      }
    },
    "Keeproll saves a smaller copy (HEVC, up to 1080p) to your library first, with the same date and place. The original then goes to Review. Nothing is deleted until you confirm.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll पहले आपकी लाइब्रेरी में छोटी कॉपी (HEVC, 1080p तक) सेव करता है, उसी तारीख़ और जगह के साथ। फिर असली फ़ाइल समीक्षा में जाती है। आपकी पुष्टि तक कुछ नहीं हटता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll முதலில் உங்கள் லைப்ரரியில் அதே தேதி மற்றும் இடத்துடன் சிறிய நகலை (HEVC, 1080p வரை) சேமிக்கும். பின்னர் அசல் சரிபார்ப்புக்குச் செல்லும். நீங்கள் உறுதிசெய்யும் வரை எதுவும் நீக்கப்படாது."
          }
        }
      }
    },
    "Keeproll saves a still copy of each one to your library first, with the same date, place and favourite. The Live Photo originals then go to Review. Nothing is deleted until you confirm.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll पहले हर एक की स्थिर कॉपी उसी तारीख़, जगह और पसंदीदा निशान के साथ आपकी लाइब्रेरी में सेव करता है। फिर असली Live Photos समीक्षा में जाती हैं। आपकी पुष्टि तक कुछ नहीं हटता।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeproll முதலில் ஒவ்வொன்றின் நிலைப் படத்தையும் அதே தேதி, இடம், பிடித்தக் குறியுடன் உங்கள் லைப்ரரியில் சேமிக்கும். பின்னர் அசல் Live Photos சரிபார்ப்புக்குச் செல்லும். நீங்கள் உறுதிசெய்யும் வரை எதுவும் நீக்கப்படாது."
          }
        }
      }
    },
