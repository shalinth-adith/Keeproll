        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "~%@ சேமி"
          }
        }
      }
    },
    "Saved a copy to your library.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी में एक कॉपी सेव हुई।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் லைப்ரரியில் ஒரு நகல் சேமிக்கப்பட்டது."
          }
        }
      }
    },
    "Saved before any contact or calendar change. Open one in Contacts or Calendar to bring things back. Backups older than 90 days are deleted.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी संपर्क या कैलेंडर बदलाव से पहले सेव होता है। चीज़ें वापस लाने के लिए इसे संपर्क या कैलेंडर में खोलें। 90 दिन से पुराने बैकअप हट जाते हैं।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எந்தத் தொடர்பு அல்லது நாள்காட்டி மாற்றத்துக்கும் முன் சேமிக்கப்படும். திரும்பக் கொண்டுவர அதை Contacts அல்லது Calendar-இல் திறக்கவும். 90 நாட்களுக்கு மேலான காப்புப்பிரதிகள் நீக்கப்படும்."
          }
        }
      }
    },
    "Saved from Chats": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट से सेव हुईं"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சாட்டிலிருந்து சேமித்தவை"
          }
        }
      }
    },
    "Saving stills… %lld of %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Saving stills… %1$lld of %2$lld"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थिर फ़ोटो सेव हो रही हैं… %lld में से %lld"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிலைப் படங்களைச் சேமிக்கிறது… %lld / %lld"
          }
        }
      }
    },
    "Saving the copy…": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी सेव हो रही है…"
