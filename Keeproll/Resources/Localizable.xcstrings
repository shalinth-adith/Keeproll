    },
    "No camera data plus one more sign.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा डेटा नहीं, और एक और संकेत।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேமரா தரவு இல்லை, மேலும் ஒரு அறிகுறி."
          }
        }
      }
    },
    "No camera data, and the size or file name of a chat app.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा डेटा नहीं, और आकार या फ़ाइल नाम चैट ऐप जैसा।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேமரா தரவு இல்லை, மேலும் சாட் ஆப்பின் அளவு அல்லது கோப்புப் பெயர்."
          }
