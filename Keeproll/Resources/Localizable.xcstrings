    },
    "^[%lld report](inflect: true) kept on this iPhone. Share the latest with a bug report.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld रिपोर्ट इस iPhone पर रखी हैं। बग रिपोर्ट के साथ नवीनतम शेयर करें।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld அறிக்கைகள் இந்த iPhone இல் உள்ளன. பிழை அறிக்கையுடன் சமீபத்தியதைப் பகிரவும்."
          }
        }
      }
    },
    "^[%lld screenshot](inflect: true)": {
      "localizations": {
